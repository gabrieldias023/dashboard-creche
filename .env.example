# Copie este arquivo para .env (que fica no .gitignore, NUNCA é commitado)
# e preencha com os valores reais.
#
# Token de acesso do Instagram (gerado no painel do app do Meta,
# em Instagram > Configuração da API com login do Instagram > Gerar token).
META_TOKEN=

# ID da conta profissional do Instagram (opcional).
# Com o token de Instagram Login, o script usa "me" se este campo ficar vazio.
# Para a creche @emeineuzagraf o ID é 17841448852085302.
IG_USER_ID=17841448852085302
